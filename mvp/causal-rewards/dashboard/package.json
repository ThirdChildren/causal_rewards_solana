{
  "name": "@causal-rewards/dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Public read-only dashboard for the Causal Rewards Protocol: experiment state, evidence epochs, results with uncertainty, challenges, claims, and one-click audit-bundle export.",
  "type": "module",
  "scripts": {
    "sync:fixtures": "node scripts/sync-fixtures.mjs",
    "predev": "npm run sync:fixtures",
    "dev": "vite",
    "prebuild": "npm run sync:fixtures",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:fixture": "node scripts/export-bundle.mjs"
  },
  "dependencies": {
    "@causal-rewards/sdk": "file:../sdk/typescript",
    "hyparquet": "1.26.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
